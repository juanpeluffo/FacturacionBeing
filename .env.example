# Database
DATABASE_URL="postgresql://user:password@localhost:5432/cuentacorriente"

# NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="your-nextauth-secret-change-this-in-production"

# Admin credentials (used for seeding)
ADMIN_EMAIL="admin@agency.com"
ADMIN_PASSWORD="changeme123"

# Talo Pay
TALO_API_KEY="your-talo-api-key"
TALO_BASE_URL="https://api.talopay.com.ar"

# Resend (email)
RESEND_API_KEY="re_your_resend_api_key"
RESEND_FROM_EMAIL="facturacion@agencia.com"

# WhatsApp (optional - leave empty to use wa.me links)
WHATSAPP_API_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""

# Agency info (public vars shown in UI)
NEXT_PUBLIC_AGENCY_NAME="Tu Agencia Digital"
AGENCY_NAME="Tu Agencia Digital"
AGENCY_ADDRESS="Av. Corrientes 1234, CABA, Argentina"
AGENCY_CUIT="20-12345678-9"
AGENCY_CVU="0000003100027777777777"

# AFIP (for electronic invoicing)
AFIP_CUIT="20123456789"
AFIP_PUNTO_VENTA="1"
AFIP_CERT_PATH="./certs/afip.crt"
AFIP_KEY_PATH="./certs/afip.key"
AFIP_PRODUCTION="false"

# Webhook secret (Talo Pay sends this to verify webhooks)
TALO_WEBHOOK_SECRET="your-talo-webhook-secret"
